{
  "name": "shat-roulette",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "realtime": "wrangler dev -c worker/wrangler.toml --port 8787 --persist-to .wrangler/state",
    "realtime:deploy": "wrangler deploy -c worker/wrangler.toml",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "app:build": "opennextjs-cloudflare build",
    "app:preview": "opennextjs-cloudflare preview",
    "app:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:lobby": "node test/lobby.test.mjs",
    "test:auth": "node test/auth.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply shat-roulette --local",
    "db:migrate": "wrangler d1 migrations apply shat-roulette --remote",
    "test:lobby-auth": "node test/lobby-auth.test.mjs",
    "test:shit": "node test/shit.test.mjs",
    "test": "npm run test:lobby && npm run test:auth && npm run test:lobby-auth && npm run test:shit && npm run test:friends && npm run test:leaderboard && npm run test:ban",
    "db:setup": "node scripts/setup-d1.mjs",
    "test:friends": "node test/friends.test.mjs",
    "test:leaderboard": "node test/leaderboard.test.mjs",
    "test:ban": "node test/ban.test.mjs"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}